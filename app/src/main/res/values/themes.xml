<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TypeType" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_400</item>
        <item name="colorOnPrimary">@color/zinc_950</item>
        <item name="colorPrimaryContainer">@color/zinc_900</item>
        <item name="colorOnPrimaryContainer">@color/zinc_100</item>
        <item name="colorSecondary">@color/blue_500</item>
        <item name="colorOnSecondary">@color/zinc_950</item>
        <item name="android:colorBackground">@color/zinc_950</item>
        <item name="colorSurface">@color/zinc_900</item>
        <item name="colorOnSurface">@color/zinc_100</item>
        <item name="colorOutline">@color/zinc_800</item>
        <item name="colorError">@color/red_500</item>
        <item name="colorOnError">@color/zinc_100</item>

        <item name="android:statusBarColor">@color/zinc_950</item>
        <item name="android:navigationBarColor">@color/zinc_950</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.TypeType.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/red_600</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TypeType</item>
    </style>
</resources>
